{
    "[typescript]": {
        "editor.tabSize": 2
    },
    "[typescriptreact]": {
        "editor.tabSize": 2
    },
    // paper/ の原稿はエンジンが原稿ごとに違う:
    //   paper/extended-abstract … ltjsarticle (LuaTeX-ja) なので LuaLaTeX
    //   paper/main             … xeCJK なので XeLaTeX
    // そこで latexmk にはエンジンを渡さず、各ディレクトリの latexmkrc
    // ($pdf_mode = 4 / 5) に決めさせる（LaTeX Workshop は原稿のディレクトリで
    // latexmk を起動するので、そこの latexmkrc が読まれる）。ここで -lualatex を
    // 固定すると paper/main が "The xeCJK package requires XeTeX" で失敗し、
    // 壊れた PDF でコミット済みの PDF を上書きしてしまう。
    //
    // "FONTCONFIG_FILE" は XeLaTeX が Latin Modern と Noto CJK を名前で見つける
    // ためのもの（paper/main/README.md 参照）。
    //
    // "env.PATH" を明示しているのは別の理由もある: この環境は code serve-web
    // 経由で動いており、拡張機能ホストは systemd --user から直接起動されるため
    // シェルの rc ファイル（PATH に texlive を足す部分）を経由しない。
    // その結果 PATH に texlive が入らず lualatex/latexmk が見つからずビルドが
    // 失敗することがある（起動方法やポートを変えるたびに再発しうる）。
    // ここで PATH を明示することで、起動元の環境に依存せず動くようにしている。
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {
                "PATH": "/usr/local/texlive/2025/bin/x86_64-linux:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "FONTCONFIG_FILE": "/home/ogiekako/scratch/fonts/fonts.conf"
            }
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ],
            "env": {
                "PATH": "/usr/local/texlive/2025/bin/x86_64-linux:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
            }
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (エンジンは latexmkrc)",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "lualatex x2",
            "tools": [
                "lualatex",
                "lualatex"
            ]
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.fdb_latexmk",
        "*.fls",
        "*.log",
        "*.out",
        "*.synctex.gz",
        "*.toc",
        "*.xdv"
    ]
}
